# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Environment and secrets
.env
.env.local
.env.*
!.env.example

# Data and generated artifacts
# (git can't re-include a file whose parent folder is ignored, so the folders
# themselves are un-ignored and their contents ignored one level down)
data/*
!data/README.md
!data/raw/
data/raw/*
!data/raw/.gitkeep
!data/processed/
data/processed/*
!data/processed/.gitkeep
# The scraped UC Tech Transfer CSVs are versioned so teammates don't need to
# re-scrape (raw HTML in data/raw/ stays local).
!data/processed/uc_techtransfer/
results/*
!results/.gitkeep
models/*
!models/.gitkeep

# OS/editor files
.DS_Store
.vscode/
.idea/

# Test and coverage outputs
.pytest_cache/
.coverage
htmlcov/
